# /etc/systemd/system/lectern.service  (bare-metal alternative to Docker)
# Create the service user first and hand it ownership of the app dir:
#   useradd --system --home /opt/lectern lectern
#   chown -R lectern:lectern /opt/lectern
# After writing: systemctl daemon-reload && systemctl enable --now lectern
[Unit]
Description=lectern — synced slide sharing
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lectern
User=lectern
Group=lectern
Environment=PORT=3100
Environment=DATA_DIR=/opt/lectern/data
Environment=EMAIL_PROVIDER=dev
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
