# /etc/systemd/system/present.service
# After writing: systemctl daemon-reload && systemctl enable --now present
[Unit]
Description=present — synced slide sharing
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/present
Environment=PORT=3000
Environment=PRESENTER_SECRET=CHANGE-ME
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
