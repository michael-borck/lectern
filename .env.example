# Email delivery of login codes:
#   dev    (default) — codes are printed to the container log; no email sent
#   smtp   — use SMTP_* below
#   resend — use RESEND_API_KEY below
EMAIL_PROVIDER=dev
EMAIL_FROM=lectern@yourdomain.com

# Restrict which email domains can sign in (comma-separated, empty = anyone)
ALLOWED_DOMAINS=

# SMTP settings (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend (EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# --- proxy / abuse / resource limits ---
# Trust X-Forwarded-For for client IPs. Only enable when behind a proxy (e.g. Caddy),
# otherwise clients can spoof it and dodge rate limits.
TRUST_PROXY=false
# Comma-separated allowed WebSocket origins; empty = require Origin host == Host
ALLOWED_ORIGINS=
# Concurrent WebSocket connections per IP
MAX_WS_PER_IP=50
# Stored bytes per user (all decks) and per converted deck
MAX_USER_BYTES=524288000
MAX_DECK_BYTES=209715200
# Cap on in-process rate-limit buckets
MAX_RATE_BUCKETS=50000
