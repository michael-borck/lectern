# Email delivery of login codes:
#   dev    (default) — codes are printed to the container log; no email sent
#   smtp   — use SMTP_* below
#   resend — use RESEND_API_KEY below
EMAIL_PROVIDER=dev
EMAIL_FROM=lectern@yourdomain.com

# Restrict which email domains can sign in (comma-separated, empty = anyone)
ALLOWED_DOMAINS=

# SMTP settings (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend (EMAIL_PROVIDER=resend)
RESEND_API_KEY=
